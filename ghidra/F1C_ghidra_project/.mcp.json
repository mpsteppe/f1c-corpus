{
  "mcpServers": {
    "ida-pro-mcp": {
      "type": "http",
      "url": "http://127.0.0.1:13337/mcp"
    },
    "ghidra-mcp": {
      "command": "%USERPROFILE%\\.local\\bin\\uv.exe",
      "args": ["run", "--project", "%USERPROFILE%\\Desktop\\ghidra-mcp", "bridge-mcp-ghidra", "--transport", "stdio"],
      "env": {
        "GHIDRA_MCP_URL": "http://127.0.0.1:8089",
        "PYTHONIOENCODING": "utf-8"
      },
      "cwd": "%USERPROFILE%\\Desktop\\ghidra-mcp"
    }
  }
}