  "clean_pseudocode": [
    "int CreateDirectoryAWrapper(LPCSTR lpPathName) {",
    "  DWORD LastError;",
    "  if ( CreateDirectoryA(lpPathName, 0) )",
    "    LastError = 0;",
    "  else",
    "    LastError = GetLastError();",
    "  if ( !LastError )",
    "    return 0;",
    "  ErrorIDLookupTable(LastError);",
    "  return -1;",
    "}"
