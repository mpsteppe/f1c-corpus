  "clean_pseudocode": [
    "int Transform32PointMDCT(float *outL, float *outR, const float in[32]) {",
    "  fold_pairs(in, scratch);            // flt_8B5924..0x8B5960 sums, flt_8B59A0..0x8B5968 diffs",
    "  scale_diffs(scratch, cosTable);     // read-only 0x005B772C..0x005B77A4",
    "  butterfly_pass_A(scratch);",
    "  butterfly_pass_B(scratch);",
    "  butterfly_pass_C(scratch);         // 0.54119611 / 1.306563",
    "  butterfly_pass_D(scratch);         // 0.70710677",
    "  deinterleave(outL, outR, scratch); // a1[256] / a2[256] via this+0x0..0x400",
    "  return LODWORD(flt_8B59A0);",
    "}"
