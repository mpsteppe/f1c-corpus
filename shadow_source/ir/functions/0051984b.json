    "    if (status[8]) {",
    "        *(int*)((char*)streamBuffer + 0x4) = AudioStreamBufferFill;",
    "        int result = TextureRowCopy(this);",
    "        *(int*)((char*)streamBuffer + 0x40) = 0;",
