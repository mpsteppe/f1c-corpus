{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "F1C reconstruction contract record",
  "type": "object",
  "required": [
    "schema_version",
    "contract_id",
    "subsystem",
    "kind",
    "status",
    "source_functions",
    "signature",
    "layouts",
    "globals",
    "preconditions",
    "postconditions",
    "side_effects",
    "thread_requirement",
    "lifecycle",
    "external_dependencies",
    "evidence_refs",
    "candidate_refs",
    "disputes",
    "unresolved",
    "tests_required",
    "dependencies"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": 1 },
    "contract_id": {
      "type": "string",
      "pattern": "^[a-z0-9_]+(\\.[a-z0-9_]+)*\\.v[0-9]+$"
    },
    "subsystem": { "type": "string", "minLength": 1 },
    "kind": {
      "enum": ["interface", "type", "global", "lifecycle", "abi", "external_boundary"]
    },
    "status": {
      "enum": [
        "RAW",
        "STATIC_DERIVED",
        "RECONCILED",
        "ABI_REVIEWED",
        "OBSERVED",
        "DIFFERENTIAL_CONFIRMED",
        "IMPLEMENTED"
      ]
    },
    "source_functions": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "pattern": "^0x[0-9A-Fa-f]{8}$" }
    },
    "signature": {
      "type": "object",
      "required": ["calling_convention", "return_type", "parameters"],
      "properties": {
        "calling_convention": {
          "enum": ["unknown", "cdecl", "stdcall", "thiscall", "fastcall"]
        },
        "return_type": { "type": "string", "minLength": 1 },
        "parameters": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "type"],
            "properties": {
              "name": { "type": "string" },
              "type": { "type": "string" }
            }
          }
        }
      }
    },
    "layouts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["object", "offset", "width", "evidence_refs"],
        "properties": {
          "object": { "type": "string" },
          "offset": { "type": "string", "pattern": "^0x[0-9A-Fa-f]+$" },
          "width": { "enum": [1, 2, 4, 8] },
          "evidence_refs": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "globals": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["address", "width", "evidence_refs"],
        "properties": {
          "address": { "type": "string", "pattern": "^0x[0-9A-Fa-f]+$" },
          "width": { "enum": [1, 2, 4, 8] },
          "evidence_refs": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "preconditions": { "type": "array", "items": { "type": "string" } },
    "postconditions": { "type": "array", "items": { "type": "string" } },
    "side_effects": { "type": "array", "items": { "type": "string" } },
    "thread_requirement": {
      "enum": ["unknown", "game_thread", "any_thread", "load_thread"]
    },
    "lifecycle": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["phase", "owner", "evidence_refs"],
        "properties": {
          "phase": { "type": "string" },
          "owner": { "type": "string" },
          "evidence_refs": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "external_dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "boundary"],
        "properties": {
          "name": { "type": "string" },
          "boundary": {
            "enum": ["windows", "directx", "miles_audio", "network", "crt", "other"]
          }
        }
      }
    },
    "evidence_refs": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string" }
    },
    "candidate_refs": { "type": "array", "items": { "type": "string" } },
    "disputes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["field", "description"],
        "properties": {
          "field": { "type": "string" },
          "description": { "type": "string" }
        }
      }
    },
    "unresolved": { "type": "array", "items": { "type": "string" } },
    "tests_required": { "type": "array", "items": { "type": "string" } },
    "dependencies": { "type": "array", "items": { "type": "string" } }
  }
}
