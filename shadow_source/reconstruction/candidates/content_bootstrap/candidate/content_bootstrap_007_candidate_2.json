  "preconditions": [
    "installation path globals (dword_5EC3D8 / byte_5EA438 fallback) resolved before path-forming calls at 0x0049B0A0, 0x0049CA00, 0x0049CD80",
    "0x0049B0A0 runs after MAS archive subsystem (sub_53CBC0) is available to open the boot media archive",
    "0x0049CA00 expects cockpit gauge object storage readable; its init guard byte at +0x00 may be unset on first call",
    "0x004A2010 requires a non-null node chain handle (a3) and dword_7CF884 <= *this; otherwise it returns early (0 or -1)",
    "0x004A1F80/0x004A2220 assume heap nodes were allocated via the paired allocator so FreeWrapper_7bcf / ShortComputation_d4d0 are valid"
  ],
  "postconditions": [
    "0x0049B0A0 on success populates dword_7CE23C[0..3] with boot bitmap handles and returns 0; on archive failure returns non-zero and frees any allocated slots back to 0",
    "0x0049CA00 sets the cockpit gauge init guard byte at +0x00 to 1 after first successful setup and returns BOOL success",
    "0x0049CD80 stores a6/a7 at a1+0x14 / a1+0x18 and, when the gauge link is resolvable, renders the gauge rect and creates an audio handle",
    "0x004A2010 on success copies the name to this+0x04, fills this+0x68 (child count) and this+0x6C (index array) and returns 0; on resource failure returns -1",
    "0x004A1FD0 leaves this+0x00 = min, this+0x04 = max, this+0x08 = 1/(max-min), or this+0x08 = 0 when max <= min",
    "0x004A2220 resets all fields, frees the 3D sound source, the buffer at this+0x6C and the 28-byte-stride array at this+0x74, and returns the last freed value"
  ],
  "side_effects": [
    "0x0049B0A0 allocates 40-byte objects via OperatorNewNhMallocWrapper and, on bitmap load failure, releases them via ResourceCleanup_cd10 + FreeWrapper_7bcf",
    "0x0049CA00 writes cockpit gauge object fields +0x04..+0x48 and invokes 0x0049CD80 on five gauge cell sub-objects",
    "0x0049CD80 performs a 2D rectangle render and creates an audio sound handle",
    "0x004A00A0 hides the cursor, conditionally loads a flash file, dispatches a long chain of frame subsystems and updates session globals (dword_7C54DC/dword_7C54E0/dword_7C54E8 family)",
    "0x004A0490 writes state globals dword_5CC9E8 and dword_7D0410, invokes a virtual call on dword_5EB10C and resets season scoring",
    "0x004A1F80 frees every node reachable from the four list heads through the +0x44 link field",
    "0x004A2220 destroys owned child objects (3D sound source, pointer buffer, 28-byte-stride array)",
    "string wrapper group (0x00499E40..0x004A2E0, 0x004A1EA0, 0x004A1E20, 0x004A1EC0) delegates to the out-of-packet StringCopyWithBufferRealloc / sub_5665B0 helpers"
  ],
