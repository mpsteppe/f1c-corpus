  "disputes": [
    {
      "field": "signature",
      "description": "Packet 007 groups 25 heterogeneous functions (near-identical string wrappers, boot bitmap loader, cockpit LED gauge setup + helper, game frame tick, session state handler, small thiscall init/teardown helpers, pit-crew mesh loader pair, object destructor). The single required signature records only the primary entry 0x0049B0A0; per-function roles are cited individually and the packet is not one type or one callable."
    },
    {
      "field": "calling_convention",
      "description": "0x0049B0A0, 0x004A00A0 and 0x004A0490 have no convention label in the raw C. Recorded as unknown; the wrappers 0x00499E40..0x004A2E0 are __stdcall per label and the mesh/gauge helpers are __thiscall per label."
    },
    {
      "field": "return_type",
      "description": "0x0049AD50 returns an uninitialized `result` on the lpSrcStr==NULL path in the raw C (Hex-Rays artifact). The real null-path return value is unknown."
    },
    {
      "field": "0x004A1EA0",
      "description": "Body ignores the StringCopyWithBufferRealloc result and returns constant 1. Whether this is a genuine success-stub or a decompiler artifact is unresolved."
    },
    {
      "field": "0x004A1F80",
      "description": "Return value is the last traversed node pointer after freeing (reused `result` accumulator), a Hex-Rays artifact; the meaningful return is likely NULL."
    }
  ],
  "unresolved": [
