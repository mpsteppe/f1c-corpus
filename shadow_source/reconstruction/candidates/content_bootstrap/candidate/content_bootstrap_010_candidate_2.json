  "preconditions": [
    "0x0053CBC0: a2 must be a non-empty NUL-terminated path; empty input returns 0 without opening",
    "0x0053C800: registry grows only while dword_8B8E30 < 32; entries are deduplicated by strcmp against existing strings",
    "0x0053CA00: registry entries carry a flag dword at +0x00; 0x400 marks an entry as in-use before pruning",
    "0x0053CE40: a1 must be an archive previously returned by 0x0053CBC0 and still linked in the dword_8B8F14 list",
    "0x004F4270: a2 names an existing .hdv/.svm file; this+52.. this+13C4 hold parse targets, a3 is the pre-zeroed setup output",
    "0x004F8D70: this points to an FPS-display object; dword_8B8DD4/dword_8B8DD8 supply screen dimensions",
    "0x004FA320/0x004FAC00: video-manager globals (dword_7CFB90 mode, dword_8AFE88 audio handle) must be valid when called"
  ],
  "postconditions": [
    "0x0053CBC0: on success a 308-byte archive object is heap-allocated, linked into the dword_8B8F14 list (+0x12C prev/+0x130 next), dword_8B6AC0 incremented, handle stored in *out_archive",
    "0x0053CBC0: returns -1 for CUBEMAS400/401 header, -2 for open failure, 0 on success",
    "0x0053CE40: archive unlinked from list, child state released, object freed, dword_8B6AC0 decremented",
    "0x0053CA00: registry compacted to entries flagged 0x400; dword_8B8E30 set to surviving count and trailing slots zeroed",
    "0x0053C900: matching registry entry's flag dword gets bit 0x400 set, then search-path pruning runs",
    "0x004F4270: vehicle definition (this) and setup (a3) populated from .hdv/.svm sections; returns 0 on success, -1 if the file failed to open",
    "0x004D8AB0: up to four MAS archives stored in dword_8AD388/8C/90/94; each opened archive's +0x5C/+0x60 receive this[57]/this[58]",
    "0x004FA320: video manager initialized and audio engine handle dword_8AFE88 set; returns 0 on success, 1 on scene-load failure"
  ],
  "side_effects": [
    "0x0053CBC0 reads 12 bytes of the target file header and compares against CUBEMAS410/CUBEMAS400/CUBEMAS401 via string:CUBEMAS410",
    "0x0053C800/0x0053C900/0x0053CA00 mutate globals byte_8B5A3C/dword_8B5A38/dword_8B8E30; entries are 132-byte {dword flag, char[128] string} records",
    "0x0053C590 copies its input into byte_8B6AC8; 0x0053C5B0 copies byte_8B6AC8 back into its argument",
    "0x004DCBA0 allocates a 96-byte zero-filled subobject, sets +0x44 flag bit 1, and may create a DirectX texture",
    "0x004DD4D0 frees this[5]; 0x004DD550 computes a scene-graph bounding box into a2 (min) / a3 (max) from node +0x14 flags and +0xF4 scale",
    "0x004DDAD0 builds pit-crew texture path lists from per-part MAS names and calls TextureAdjuster",
    "0x004F4270 opens a MAS archive for the .hdv path, parses section keywords (general/frontwing/rearwing/bodyaero/diffuser/suspension/controls/engine/driveline/basic), writes many vehicle_def and vehicle_setup fields",
    "0x004F8D70 opens the FPS font MAS (aFontMas) and initializes the framerate display",
    "0x004FA320 initializes audio via AudioEngineInitialization(&dword_8AFE88); 0x004FAC00 tears down dword_8AFE88 and resets the framerate counter",
    "0x004FC550 opens logomap.mas, optionally randomizes cloud objects, and copies cloud texture paths into this+0x50 and this+0x84",
    "0x00543FA0 frees and reallocates vertex/mesh buffers (24*n+4 and 528*n+4 allocations) on the render_object, walking render_nodes via +0x104 next",
    "0x005450E0 allocates a 572-byte mesh resource, stores a4 at +0x3C, and copies a name string",
    "0x00545150 destroys child 3D-sound sources at scene_node +0x44/+0x4C, unlinks +0x230 from the graph, and frees the node",
    "0x00545250 sets scene_node +0x3C flag bit 3, zeroes +0x4C, and appends the node to scene_root +0x108 via +0x48/+0x4C links",
    "0x004D7AA0 acquires a lock on *(a1+4), formats a message to it, and releases the lock (debug log write)"
  ],
  "thread_requirement": "unknown",
