  "preconditions": [
    "sub_4A4900's `this` is a pit-object whose +0x00 holds a pointer to a valid vehicle/pit entry (it dereferences *this+0x4714 and *this+0x4894).",
    "global dword_8AB6E4 != 2, otherwise sub_4A4900 returns immediately without loading.",
    "global path/string globals byte_5EA438, dword_5EC3D8, dword_5EC420, dword_5EC428 are initialized or fall back to byte_5EA438 in the loaders.",
    "container records (24 bytes) are zeroed before first use via StructInitCall (sub_4A2980) before being handed to PITANIMSMASAnimationFileLoader.",
    "sub_4A2A90 requires the target file to open (sub_587DB0 returns nonzero) else returns -1 without side effects."
  ],
  "postconditions": [
    "sub_4A4900 leaves pit_object +0x0C (normal pit crew), +0x10 (10-sec pit crew), +0x14 (pit director) holding loaded containers or null.",
    "each pitcrew_container has +0x0C = actor count and +0x10 = pointer to an array of 120-byte actor records (allocated with 120*count+4 header).",
    "each actor with moves has +0x70 = move count and +0x74 = pointer to a 28-byte-stride move array; the move +0x18 animation id is 0..23.",
    "sub_4A2A90 sets container +0x00 to 1 and leaves +0x08 cleared after FlagBasedLoopConditionalCall (masked to &~3).",
    "sub_4A4900 returns the ArithmeticComparison_1f80 result over its loaded-resource marker v44 (nonzero on match)."
  ],
  "side_effects": [
    "registers and matches path strings in the string registry (StringRegistry / StringMatchWithFlagSet) across sub_4A3220, sub_4A3910, sub_4A4900.",
    "allocates/frees temporary heap buffers via OperatorNewNhMallocWrapper / FreeWrapper_7bcf (actor arrays, move arrays, 256-byte path buffers).",
    "opens/closes resource file handles (FileReadUntilNewline / FileCloseWithLock in sub_4A2A90 and sub_4A51C0).",
    "removes registry-handle list nodes via PhysicsObjectLinkedListRemoval for the .mas lookups in sub_4A3220, sub_4A3910, sub_4A4900.",
    "sub_4A51C0 opens a Miles audio stream (AudioStreamOpen(a2, 1)) and is short-circuited by its stream-handle marker v7[0].",
    "sub_4A3B50 advances the camera-noise index dword_8AAE70 and reads the flt_8AB274 table, and may write the spatial-grid query result into its record.",
    "sub_4A5F20 clears pit_object +0x180, increments vehicle+0x406C, and calls StateChangeNotify / AIFormationLap when the exiting-pits flag is set."
  ],
