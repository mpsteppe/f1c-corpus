{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "F1C shadow-source recovered function",
  "type": "object",
  "required": [
    "schema_version", "address", "proposed_name", "owner", "summary",
    "operations", "unresolved", "unresolved_evidence_refs", "confidence"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "address": {"pattern": "^0x[0-9A-F]{8}$"},
    "proposed_name": {"pattern": "^[A-Za-z_][A-Za-z0-9_]*$"},
    "owner": {
      "type": "object",
      "required": ["type", "trust", "evidence_refs"],
      "properties": {
        "type": {"type": "string"},
        "trust": {"enum": ["CONFIRMED", "DERIVED", "GUESS", "UNKNOWN"]},
        "evidence_refs": {"type": "array", "items": {"type": "string"}}
      }
    },
    "summary": {"type": "string"},
    "local_names": {"type": "object", "additionalProperties": {"type": "string"}},
    "operations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["kind", "description", "evidence_refs"],
        "properties": {
          "kind": {
            "enum": ["guard", "assignment", "call", "calculation", "loop",
                     "state_transition", "return", "unknown"]
          },
          "description": {"type": "string"},
          "evidence_refs": {"type": "array", "items": {"type": "string"}}
        }
      }
    },
    "clean_pseudocode": {"type": "array", "items": {"type": "string"}},
    "unresolved": {"type": "array", "items": {"type": "string"}},
    "unresolved_evidence_refs": {"type": "array", "items": {"type": "string"}},
    "confidence": {
      "type": "object",
      "required": ["semantics", "owner", "control_flow"],
      "properties": {
        "semantics": {"enum": ["HIGH", "MEDIUM", "LOW"]},
        "owner": {"enum": ["HIGH", "MEDIUM", "LOW"]},
        "control_flow": {"enum": ["HIGH", "MEDIUM", "LOW"]}
      }
    }
  }
}
