{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "F1C shadow-source architecture proposal",
  "type": "object",
  "required": [
    "schema_version", "packet_id", "scope", "subsystem", "summary",
    "function_roles", "classes", "state_machines", "interfaces",
    "dependencies", "compatibility_contracts", "unresolved",
    "unresolved_evidence_refs", "confidence"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "packet_id": {"type": "string"},
    "scope": {"type": "string"},
    "subsystem": {
      "type": "object",
      "required": ["name", "responsibility", "trust", "evidence_refs"],
      "properties": {
        "name": {"type": "string"},
        "responsibility": {"type": "string"},
        "trust": {"enum": ["DERIVED", "GUESS", "UNKNOWN"]},
        "evidence_refs": {"type": "array", "items": {"type": "string"}}
      }
    },
    "summary": {"type": "string"},
    "function_roles": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["address", "role", "owner", "evidence_refs"],
        "properties": {
          "address": {"pattern": "^0x[0-9A-F]{8}$"},
          "role": {"type": "string"},
          "owner": {"type": "string"},
          "evidence_refs": {"type": "array", "items": {"type": "string"}}
        }
      }
    },
    "classes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "responsibility", "trust", "methods", "fields", "evidence_refs"],
        "properties": {
          "name": {"type": "string"},
          "responsibility": {"type": "string"},
          "trust": {"enum": ["DERIVED", "GUESS", "UNKNOWN"]},
          "methods": {"type": "array", "items": {"pattern": "^0x[0-9A-F]{8}$"}},
          "fields": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["base", "offset", "name", "type_guess", "trust", "access", "evidence_refs"],
              "properties": {
                "base": {"type": "string"},
                "offset": {"pattern": "^0x[0-9A-F]{8}$"},
                "name": {"type": "string"},
                "type_guess": {"type": "string"},
                "trust": {"enum": ["DERIVED", "GUESS", "UNKNOWN"]},
                "access": {"enum": ["read", "write", "read_write", "unknown"]},
                "evidence_refs": {"type": "array", "items": {"type": "string"}}
              }
            }
          },
          "evidence_refs": {"type": "array", "items": {"type": "string"}}
        }
      }
    },
    "state_machines": {"type": "array"},
    "interfaces": {"type": "array"},
    "dependencies": {"type": "array"},
    "compatibility_contracts": {"type": "array"},
    "unresolved": {"type": "array", "items": {"type": "string"}},
    "unresolved_evidence_refs": {"type": "array", "items": {"type": "string"}},
    "confidence": {
      "type": "object",
      "required": ["boundaries", "ownership", "field_semantics", "contracts"],
      "properties": {
        "boundaries": {"enum": ["HIGH", "MEDIUM", "LOW"]},
        "ownership": {"enum": ["HIGH", "MEDIUM", "LOW"]},
        "field_semantics": {"enum": ["HIGH", "MEDIUM", "LOW"]},
        "contracts": {"enum": ["HIGH", "MEDIUM", "LOW"]}
      }
    }
  }
}
