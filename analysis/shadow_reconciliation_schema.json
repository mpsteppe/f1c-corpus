{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "F1C shadow architecture reconciliation candidate",
  "type": "object",
  "required": [
    "schema_version", "packet_id", "summary", "engine_subsystems",
    "canonical_type_families", "state_machines", "interfaces",
    "dependencies", "compatibility_contracts", "conflicts", "unresolved",
    "unresolved_evidence_refs", "confidence"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "packet_id": {"type": "string"},
    "summary": {"type": "string"},
    "engine_subsystems": {"type": "array"},
    "canonical_type_families": {"type": "array"},
    "state_machines": {"type": "array"},
    "interfaces": {"type": "array"},
    "dependencies": {"type": "array"},
    "compatibility_contracts": {"type": "array"},
    "conflicts": {"type": "array"},
    "unresolved": {"type": "array", "items": {"type": "string"}},
    "unresolved_evidence_refs": {"type": "array", "items": {"type": "string"}},
    "confidence": {
      "type": "object",
      "required": ["subsystems", "type_families", "state_machines", "contracts"],
      "properties": {
        "subsystems": {"enum": ["HIGH", "MEDIUM", "LOW"]},
        "type_families": {"enum": ["HIGH", "MEDIUM", "LOW"]},
        "state_machines": {"enum": ["HIGH", "MEDIUM", "LOW"]},
        "contracts": {"enum": ["HIGH", "MEDIUM", "LOW"]}
      }
    }
  }
}
