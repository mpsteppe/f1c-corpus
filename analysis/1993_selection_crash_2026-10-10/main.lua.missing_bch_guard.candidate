local success, loadedModule = pcall(require, "moduletest")
if success then
 print("moduletest.dll loaded")
else
 print("moduletest.dll loading failed")
end

-- Lets make Table where we store the Config settings

ConfigSettings = {}

-- Now read some Config.ini settings

f = io.open("Config.ini","r")
-- set f as default input
io.input(f)

-- traverse through each lines
for line in io.lines() do
   local length = string.len(line)
   i, j = string.find(line, '=')
   if i then 
    -- Adding Config settings into table
	 ConfigSettings[string.upper(string.sub(line, 0 ,j-1))] = string.sub(line, j+1)
   end
end
io.close(f)

-- Now lets write new Config.ini and use the table data what we stored

file = io.open("Config.ini","w")

function writedata(f,s)
 f:write(s.."="..ConfigSettings[s].."\n")
end

file:write("[COMPONENTS]\n")
if (string.len(ConfigSettings["SEASONDIR"]) >= 2) then
writedata(file,"SEASONDIR")
else
file:write("SEASONDIR=SEASONDATA\\\n")
print("we added self the SEASONDIR manually ")
end
writedata(file,"SOUNDDIR")
writedata(file,"VEHICLESOUND")
writedata(file,"OPTIONSANIM")
writedata(file,"OPTIONSFLAGS")
writedata(file,"OPTIONSSOUNDS")
writedata(file,"OPTIONSDIR")
writedata(file,"REPLAYDIR")
writedata(file,"MOVIEDIR")
writedata(file,"TRACKSDIR")
writedata(file,"VEHICLESDIR")
writedata(file,"DRIVERSDIR")
writedata(file,"LOGDIR")
writedata(file,"SAVEDIR")
writedata(file,"MUSICDIR")
writedata(file,"CAMERAEDITORRESOURCEDIR")
writedata(file,"GRIDSIZE")
writedata(file,"CPURATING")
writedata(file,"SYSTEMRAM")
writedata(file,"VIDEORAM")
--writedata(file,"OBJDETAIL")
--writedata(file,"TEXDETAIL")
-- lets add self manually best game quality setting
file:write("OBJDETAIL=3\n")
file:write("TEXDETAIL=3\n")
--
writedata(file,"VIDEOGUID")
writedata(file,"VIDEODRIVER")
writedata(file,"VIDEOMODE")
writedata(file,"VIDEOREFRESH")
writedata(file,"WINDOWEDMODE")
writedata(file,"RUNBENCHMARKS")
--writedata(file,"FSAA")
-- lets diable fsaa manually if user self not todo this, needed for the vsync
file:write("FSAA=0\n")
--writedata(file,"VSYNC")
-- lets enable vsync manually if user self not todo this
file:write("VSYNC=1\n")
--
writedata(file,"VBSTRATEGY")
file:write("\n")
file:write("[INSTALL]\n")
writedata(file,"INSTALLFROM")
writedata(file,"INSTALLTO")
-- game adds those self
--file:write("\n")
--file:write("[AUTOLAUNCH]\n")
--writedata(file,"MODE")
--writedata(file,"LAUNCHTIME")
file:write("\n")
file:write("[VERSION]\n")
writedata(file,"VERSION")

file:close()

-- this function shows what files game want open, can todo example the file modification before opening

function CreateFile(_afile)
 -- A season history file may not exist until the game creates it.
 local probe = io.open(_afile, "r")
 if not probe then return end
 probe:close()

-- lets auto fix the bch files GAMEOPT_opponents vaule
   i, j = string.find(_afile, '.bch')
   if i then 
	 local lines = {}
	 local opponents = 0;
	 
     for line in io.lines(_afile) do 
       lines[#lines + 1] = line
	   
	  ii, ji = string.find(tostring(line), '%[OPPONENT')
      if ii then 
        opponents = opponents + 1	  
	  end
     end	 

	 
	 np = oph.noPlayer() -- this checks if player is ai or not
	 
	 file = io.open(_afile,"w")
	 
	 for k,v in pairs(lines) do
      ii, ji = string.find(tostring(v), 'GAMEOPT_opponents')
      if ii then 
	    if np then
		  file:write("GAMEOPT_opponents="..tostring(opponents+1) .."\n")
		else
		  file:write("GAMEOPT_opponents="..tostring(opponents) .."\n")
		end		
      else
	    file:write(tostring(v) .."\n")	  
	  end
     end	
     print("auto fixed the ",_afile)
	 file:close()
   end
   
   
end